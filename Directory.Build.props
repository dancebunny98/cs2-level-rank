<Project>
  <PropertyGroup>
    <!-- Единственный источник версий для всех проектов и CI. -->
    <PluginVersion Condition="'$(PluginVersion)' == ''">1.2.0</PluginVersion>
    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
    <CounterStrikeSharpVersion Condition="'$(CounterStrikeSharpVersion)' == ''">1.0.376</CounterStrikeSharpVersion>
    <MySqlConnectorVersion Condition="'$(MySqlConnectorVersion)' == ''">2.6.2</MySqlConnectorVersion>
    <DapperVersion Condition="'$(DapperVersion)' == ''">2.1.24</DapperVersion>
    <MicrosoftExtensionsVersion Condition="'$(MicrosoftExtensionsVersion)' == ''">10.0.0</MicrosoftExtensionsVersion>
    <TargetFrameworkVersion Condition="'$(TargetFrameworkVersion)' == ''">net10.0</TargetFrameworkVersion>
    <Version>$(PluginVersion).$(BuildNumber)</Version>
    <AssemblyVersion>$(PluginVersion).0</AssemblyVersion>
    <FileVersion>$(PluginVersion).$(BuildNumber)</FileVersion>
    <InformationalVersion>$(PluginVersion)+build.$(BuildNumber)</InformationalVersion>
    <!-- В проекте включена nullable-аннотация, но существующие модули используют
         динамические игровые данные. Эти диагностические сообщения не являются
         ошибками сборки и не должны заглушать реальные ошибки. -->
    <NoWarn>$(NoWarn);CS0168;CS8601;CS8602;CS8603;CS8618</NoWarn>
  </PropertyGroup>
</Project>
