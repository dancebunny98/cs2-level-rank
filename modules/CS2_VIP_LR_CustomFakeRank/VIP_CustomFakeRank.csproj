<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(TargetFrameworkVersion)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Имя итоговой DLL/папки плагина - без пробелов и скобок, чтобы избежать
         багов CounterStrikeSharp с несовпадением имени папки и файла. -->
    <AssemblyName>LR_VIP_CustomFakeRank</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="$(CounterStrikeSharpVersion)" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="$(MicrosoftExtensionsVersion)" />

    <!-- Собственный интерфейс IPlayerRankApi модуля FakeRank - разделяемый контракт,
         резолвится через addons/counterstrikesharp/shared/FakeRanksApi/, поэтому
         Private=false (копия в папку этого плагина не нужна и вредна). -->
    <ProjectReference Include="..\CS2-LR-FakeRank\FakeRanksApi.csproj" Private="false" ExcludeAssets="runtime" />

    <!-- Внешняя зависимость (плагин VIP-CS2), собрать из исходников не можем -
         положите VipCoreApi.dll в /libs в корне репозитория перед сборкой -->
    <Reference Include="VipCoreApi">
      <HintPath>$(VipCoreApiPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
