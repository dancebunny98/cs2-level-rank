<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="*" />

    <!-- Контракт LevelsRanksApi - разделяемая сборка
         (addons/counterstrikesharp/shared/LevelsRanksApi/).
         Private=false: свою копию в папку этого плагина класть не нужно и
         вредно - иначе у каждого плагина будет своя копия сборки, и
         PluginCapability<ILevelsRanksApi> будет падать с ошибкой приведения
         типов между разными AssemblyLoadContext. -->
    <ProjectReference Include="..\..\Api\LevelsRanksApi.csproj" Private="false" ExcludeAssets="runtime" />

    <!-- Внешняя зависимость (плагин VIP-CS2), собрать из исходников не можем -
         положите VipCoreApi.dll в /libs в корне репозитория перед сборкой -->
    <Reference Include="VipCoreApi">
      <HintPath>..\..\libs\VipCoreApi.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
