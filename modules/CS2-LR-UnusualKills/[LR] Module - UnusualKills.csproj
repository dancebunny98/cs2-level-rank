<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.366" />
    <PackageReference Include="Dapper" Version="2.1.24" />
    <PackageReference Include="MySqlConnector" Version="2.3.1" />

    <!-- Контракт LevelsRanksApi - разделяемая сборка
         (addons/counterstrikesharp/shared/LevelsRanksApi/).
         Private=false: свою копию в папку этого плагина класть не нужно и
         вредно - иначе у каждого плагина будет своя копия сборки, и
         PluginCapability<ILevelsRanksApi> будет падать с ошибкой приведения
         типов между разными AssemblyLoadContext. -->
    <ProjectReference Include="..\..\Api\LevelsRanksApi.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Include="lang\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
